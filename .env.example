# Variables de entorno de TerraGraph. Copia este archivo a .env (no se sube al repo).
# Para cargarlo en Git Bash: set -a; source .env; set +a

# URL de PostgreSQL. Si no está definida, se usa el Postgres local de
# docker/docker-compose.yml. En producción es la URL de Neon; el prefijo
# postgresql:// se cambia solo a postgresql+psycopg://.
DATABASE_URL=postgresql://terragraph:terragraph@localhost:5432/terragraph
