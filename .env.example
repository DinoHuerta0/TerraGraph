# Variables de entorno de TerraGraph. Copia este archivo a .env (no se sube al repo).
# Para cargarlo en Git Bash: set -a; source .env; set +a

# URL de PostgreSQL. Si no está definida, se usa el Postgres local de
# docker/docker-compose.yml. En producción es la URL de Neon; el prefijo
# postgresql:// se cambia solo a postgresql+psycopg://.
DATABASE_URL=postgresql://terragraph:terragraph@localhost:5432/terragraph

# Neon: usa la conexión directa (sin "-pooler" en el host) y deja sslmode=require
# para que la conexión vaya cifrada con TLS. Ponla entre comillas simples: el "&"
# de la URL rompe el `source` de Bash si no las lleva.
# DATABASE_URL='postgresql://<usuario>:<contraseña>@<host>.us-east-1.aws.neon.tech/terragraph?sslmode=require&channel_binding=require'

# Sentry: monitoreo de errores y rendimiento. Si SENTRY_DSN está vacío o no existe,
# la app corre sin monitoreo (así las pruebas y el CI no mandan eventos).
# El DSN está en Sentry: Settings → Projects → <proyecto> → Client Keys (DSN).
SENTRY_DSN=
# development en tu máquina; production en el servidor.
SENTRY_ENVIRONMENT=development
# Versión que se reporta: el SHA del commit. En el despliegue la pone el pipeline.
# SENTRY_RELEASE=
